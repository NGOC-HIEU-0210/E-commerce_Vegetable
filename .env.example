# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env

# ─── Database ──────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/javaweb34db_btck?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ─── Mail (Gmail App Password, tạo tại https://myaccount.google.com/apppasswords) ───
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ─── Keycloak ──────────────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/indmart
